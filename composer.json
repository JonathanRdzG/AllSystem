{
  "name": "allsystem/pymes-platform",
  "type": "project",
  "description": "Sistema empresarial modular para PyMEs con Laravel 12 + Vue 3 + Inertia",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "inertiajs/inertia-laravel": "^1.0",
    "laravel/breeze": "^2.0",
    "spatie/laravel-permission": "^6.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}